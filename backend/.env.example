# Copia este archivo como ".env" (sin la palabra example) y rellena los valores.
# El archivo .env es SECRETO: no lo subas a GitHub ni lo compartas con nadie.

# Cadena de conexión de MongoDB Atlas (Connect > Drivers).
# Cambia <usuario> y <contraseña> por los tuyos.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (se crea sola la primera vez).
DB_NAME=ecci_ia

# Clave del panel de moderación (/admin). Mínimo 12 caracteres, solo letras y números.
ADMIN_KEY=cambia-esta-clave-por-una-larga

# (Opcional) Solo aceptar correos de estos dominios al subir noticias. Separa con comas.
# DOMINIOS_PERMITIDOS=ucr.ac.cr

# (Opcional) Puerto del servidor.
# PUERTO=8000

# (Opcional) Guardar las imágenes en Cloudinary en vez de la carpeta uploads.
# Se copia del panel de Cloudinary (API Keys > API environment variable).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
